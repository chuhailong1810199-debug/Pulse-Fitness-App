{
  "routes": [
    { "src": "/migrate", "dest": "/migrate.html" },
    { "src": "/manifest.json", "dest": "/manifest.json", "headers": { "Content-Type": "application/manifest+json" } },
    { "src": "/(.*\\.html)?", "headers": { "Cache-Control": "no-cache, must-revalidate" }, "continue": true },
    { "src": "/", "dest": "/landing.html" },
    { "handle": "filesystem" }
  ]
}
