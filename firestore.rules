rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── VAI TRÒ — nhiều coach (docs/plan-multi-coach.md) ───────────────
    //
    //   coaches/{email viết thường}  { name, active, isAdmin, uid }  — CHỈ admin ghi
    //
    // Doc trong Firestore chứ không phải custom claims: tắt active là coach mất
    // quyền ngay ở lượt luật kế tiếp (claims sống tới 1 giờ trên token cũ), và
    // admin mời được coach TRƯỚC khi người đó đăng nhập lần đầu.
    //
    // BOOTSTRAP_ADMIN: tài khoản admin gốc luôn là admin kể cả khi doc của nó
    // lỡ bị tắt/xoá — để không bao giờ tự khoá mình ra ngoài. Cùng địa chỉ ở
    // functions/authz.js và storage.rules.
    function verifiedEmail() {
      return request.auth != null && request.auth.token.email_verified != false;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isBootstrapAdmin() {
      return verifiedEmail() && myEmail() == 'chuhailong1810199@gmail.com';
    }
    function coachPath() {
      return /databases/$(database)/documents/coaches/$(myEmail());
    }
    function isCoachRole() {
      return isBootstrapAdmin() || (verifiedEmail()
        && exists(coachPath()) && get(coachPath()).data.get('active', false) == true);
    }
    function isAdmin() {
      return isBootstrapAdmin() || (isCoachRole() && get(coachPath()).data.get('isAdmin', false) == true);
    }
    // Tên cũ, giữ cho chỗ nào chỉ cần "là coach bất kỳ" (thư viện bài tập, push).
    function isCoach() { return isCoachRole(); }

    function clientPath(clientId) {
      return /databases/$(database)/documents/clients/$(clientId);
    }
    // Coach sở hữu khách này (hoặc admin). Dùng cho subcollection — ở đó
    // get() theo id được. KHÔNG dùng cho đọc clients: truy vấn danh sách
    // không chạy được get() theo từng doc (xem match /clients).
    function canManage(clientId) {
      return isAdmin() || (isCoachRole() && exists(clientPath(clientId))
        && get(clientPath(clientId)).data.get('coachUid', null) == request.auth.uid);
    }

    // ── Helper: user hiện tại là chủ của clientId (email khớp)
    // LƯU Ý: rule này chỉ an toàn khi mỗi email chỉ thuộc về DUY NHẤT một client.
    // Tính duy nhất được cưỡng chế bởi collection /clientEmails bên dưới —
    // không được bỏ nó đi, nếu không hai client trùng email sẽ đọc/ghi được data của nhau.
    function isClientOwner(clientId) {
      return verifiedEmail() &&
        exists(clientPath(clientId)) &&
        get(clientPath(clientId)).data.email == myEmail();
    }
    function canAccess(clientId) { return canManage(clientId) || isClientOwner(clientId); }

    // Email trên hồ sơ khách phải được chỉ mục /clientEmails trỏ về đúng khách
    // đó (hoặc rỗng). Không có dòng này thì coach ghi thẳng clients.email là
    // vượt qua được chốt một Gmail một khách.
    function emailIndexed(clientId, email) {
      return email == '' || (exists(/databases/$(database)/documents/clientEmails/$(email))
        && get(/databases/$(database)/documents/clientEmails/$(email)).data.clientId == clientId);
    }

    // ── COACHES — danh sách coach, chỉ admin sửa ─────────
    match /coaches/{email} {
      allow read: if isAdmin() || (verifiedEmail() && email == myEmail());
      allow write: if isAdmin();
      // Coach đăng nhập lần đầu tự ghi uid của mình vào doc — chỉ uid và giờ
      // đăng nhập, và chỉ khi chưa có uid hoặc đúng uid đó.
      allow update: if verifiedEmail() && email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'lastLoginAt'])
        && request.resource.data.uid == request.auth.uid
        && resource.data.get('uid', request.auth.uid) == request.auth.uid;
    }

    // ── CLIENT EMAIL INDEX — cưỡng chế 1 email = 1 client ─
    // Doc id chính là email (viết thường). Firestore phân biệt create với update:
    // doc chưa tồn tại -> 'create', doc đã tồn tại -> 'update'.
    // Cho phép create, chặn update => không thể chiếm email đã có người dùng.
    // Muốn đổi email cho client thì phải delete doc cũ rồi create doc mới.
    match /clientEmails/{emailKey} {
      allow read: if request.auth != null;

      // Coach đăng ký email cho bất kỳ client nào;
      // user tự đăng ký thì CHỈ được đăng ký chính email của mình.
      // Coach chỉ chiếm Gmail cho khách CỦA MÌNH. Hồ sơ có thể chưa tồn tại
      // (addClient chiếm email trước rồi mới tạo hồ sơ) — khi đó chưa ai sở hữu.
      allow create: if request.auth != null
                    && request.resource.data.clientId is string
                    && request.resource.data.clientId.size() > 0
                    && (isAdmin()
                        || (isCoachRole() && (!exists(clientPath(request.resource.data.clientId))
                                              || canManage(request.resource.data.clientId)))
                        || emailKey == myEmail());

      allow update: if false;   // KHÔNG BAO GIỜ ghi đè — đây là chốt chặn duy nhất
      // Không thì coach B xoá chỉ mục Gmail khách của coach A rồi chiếm cho
      // khách của mình — khách đó đăng nhập sẽ mở hồ sơ của B.
      allow delete: if isAdmin() || (isCoachRole() && (!exists(clientPath(resource.data.clientId))
                                                       || canManage(resource.data.clientId)));
    }

    // ── LEADS collection ─────────────────────────────────
    // Public: ai cũng có thể tạo lead (contact form từ landing page)
    // Coach only: đọc, update, xóa
    match /leads/{leadId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'goal', 'frequency',
          'service', 'note', 'createdAt', 'source', 'status'
        ]);

      allow read, update, delete: if isAdmin();   // lead về studio (admin)
    }

    // ── USERS collection ─────────────────────────────────
    // Coach: toàn quyền (cần để dọn tài khoản mồ côi, gán lại clientId)
    // User thường: đọc profile của mình; tạo lần đầu khi đăng nhập;
    //   được sửa name/email của mình nhưng KHÔNG được tự đổi role hay clientId
    //   (nếu cho phép thì client có thể tự trỏ sang client khác).
    match /users/{uid} {
      // Chỉ admin — coach thường không cần, và bảng này chứa email/vai trò của
      // mọi người kể cả coach khác.
      allow read, write: if isAdmin();

      allow read:   if request.auth != null && request.auth.uid == uid;
      // Chỉ được tự tạo với vai trò 'client'. Bản cũ chặn đúng chữ 'coach' nên
      // tự tạo 'admin' hay bất kỳ giá trị nào khác vẫn lọt — chặn bằng danh sách
      // cho phép, không bằng danh sách cấm.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('role', 'client') == 'client';
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('role', '')     == resource.data.get('role', '')
                    && request.resource.data.get('clientId', '') == resource.data.get('clientId', '');
      allow delete: if false;   // chỉ coach mới được xoá
    }

    // ── EXERCISES collection (thư viện bài tập) ──────────
    // Tất cả user đã login đều được đọc
    // Chỉ coach mới được thêm/sửa/xóa
    match /exercises/{docId} {
      allow read: if request.auth != null;
      allow write: if isCoach();
    }

    // ── BOOKINGS collection (coach schedule only) ─────────
    // Chi tiết tài khoản nhận tiền của coach. Khách PHẢI đọc được để chuyển
    // khoản — số tài khoản sinh ra để chia sẻ — nhưng chỉ coach được sửa.
    // Bảng giá và tài khoản ngân hàng studio: chỉ admin sửa (studio thu chung).
    match /settings/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Lịch: mỗi coach chỉ lịch của mình. Đọc dùng resource.data (không get())
    // để truy vấn where('coachUid','==',uid) chạy được — cần index ghép
    // (coachUid, date) trong firestore.indexes.json.
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isCoachRole() && resource.data.coachUid == request.auth.uid);
      allow create: if isAdmin() || (isCoachRole() && request.resource.data.coachUid == request.auth.uid);
      allow update: if isAdmin() || (isCoachRole()
        && resource.data.get('coachUid', null) == request.auth.uid
        && request.resource.data.coachUid == request.auth.uid);
      allow delete: if isAdmin() || (isCoachRole() && resource.data.get('coachUid', null) == request.auth.uid);
    }

    // ── PUSH SUBSCRIPTIONS ────────────────────────────────
    // Một doc cho mỗi máy đã bật thông báo. Id là băm của endpoint, KHÔNG
    // phải uid — cùng một người trên hai máy là hai doc, nên bật ở điện thoại
    // không làm mất đăng ký trên máy tính.
    //
    // Hàm nền đọc bằng Admin SDK nên không đi qua đây. Phía máy khách chỉ
    // được tự ghi đăng ký của chính mình, và không đọc được của ai cả:
    // endpoint cộng keys là đủ để gửi thông báo tới máy người khác.
    // Trường role quyết định ai nhận push lịch và brief sáng (pushToAll lọc
    // role=='coach'). Khách tự khai 'coach' là nhận được lịch có tên khách khác
    // — nên chỉ coach thật mới được ghi role 'coach'.
    match /pushSubs/{subId} {
      allow read: if false;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid
                            && (request.resource.data.get('role', null) != 'coach' || isCoach());
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── CLIENTS collection ────────────────────────────────
    // Admin: tất cả. Coach: khách có coachUid == mình. Khách: chính mình.
    //
    // ĐỌC dùng resource.data.coachUid, KHÔNG dùng get(): luật không phải bộ
    // lọc — truy vấn danh sách chỉ được duyệt khi luật chứng minh được từ
    // where('coachUid','==',uid). isClientOwner (có get) đứng CUỐI, chỉ chạy
    // khi đọc một doc.
    match /clients/{clientId} {
      allow read: if isAdmin()
        || (isCoachRole() && resource.data.coachUid == request.auth.uid)
        || isClientOwner(clientId);

      // Coach tạo khách thì khách thuộc về chính coach đó; email (nếu có) đã
      // được chiếm ở /clientEmails trước.
      allow create: if (isAdmin()
          || (isCoachRole() && request.resource.data.coachUid == request.auth.uid))
        && emailIndexed(clientId, request.resource.data.get('email', ''));
      allow delete: if isAdmin()
        || (isCoachRole() && resource.data.get('coachUid', null) == request.auth.uid);

      // `access.paidUntil` và `coaching` là tiền — chỉ admin (studio thu chung,
      // xác nhận đã trả). Coach đổi được GÓI (access.planId) cho khách mình.
      // `coachUid` chỉ admin chuyển. `email` quyết định ai sở hữu hồ sơ, nên
      // đổi email phải đi kèm chỉ mục /clientEmails trỏ đúng khách này.
      // Khách tự sửa: không đụng access, coaching, email, coachUid.
      allow update: if (
          isAdmin()
          || (isCoachRole()
              && resource.data.get('coachUid', null) == request.auth.uid
              && request.resource.data.get('coachUid', null) == request.auth.uid
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coaching'])
              && request.resource.data.get('access', {}).get('paidUntil', null)
                 == resource.data.get('access', {}).get('paidUntil', null))
          || (isClientOwner(clientId)
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['access', 'coaching', 'email', 'coachUid']))
        )
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || emailIndexed(clientId, request.resource.data.get('email', '')));

      // Invoices are readable by the client so they can pay, and writable only
      // by the coach. This must NOT be covered by a broader wildcard below:
      // allow rules are OR-ed, so one permissive match would undo this one.
      // A client may raise their own invoice — that is a request to pay, not a
      // grant of access. Two things keep it honest: it must be created unpaid,
      // and the amount must equal the published price for the plan it names,
      // so a client cannot invoice themselves 1.000 d for the top tier.
      // Only the coach may ever mark one paid; that is what extends access.
      match /invoices/{invoiceId} {
        allow read:   if canAccess(clientId);
        // A client may raise their own invoice, but only for a figure the coach
        // published. Both kinds are checked against settings, so the amount is
        // never something the client chose: access against settings/plans, and
        // coaching against the term price stored in settings/coaching — stored
        // rather than recomputed here, so this check and the app cannot drift.
        // Coach của khách được lập hoá đơn, nhưng chỉ ở trạng thái chưa trả.
        allow create: if isAdmin()
          || (canManage(clientId) && request.resource.data.status == 'unpaid')
          || (isClientOwner(clientId)
              && request.resource.data.status == 'unpaid'
              && request.resource.data.paidAt == null
              && (
                (request.resource.data.kind == 'access'
                 && request.resource.data.amount ==
                    get(/databases/$(database)/documents/settings/plans).data[request.resource.data.planId].price
                 && request.resource.data.months ==
                    get(/databases/$(database)/documents/settings/plans).data[request.resource.data.planId].months)
                ||
                (request.resource.data.kind == 'coaching'
                 && request.resource.data.amount ==
                    get(/databases/$(database)/documents/settings/coaching)
                      .data[request.resource.data.packageId].terms[string(request.resource.data.months)])
              ));
        // A client may take back an invoice they raised by mistake, and nothing
        // else: only unpaid -> cancelled, only those two fields. Marking rather
        // than deleting keeps the record, so a cancellation cannot be used to
        // erase something already paid for.
        // Đánh dấu ĐÃ TRẢ: chỉ admin (studio nhận tiền). Coach của khách được
        // huỷ hoá đơn chưa trả, không được chuyển sang 'paid'.
        allow update: if isAdmin()
          || (canManage(clientId)
              && resource.data.status != 'paid'
              && request.resource.data.status != 'paid')
          || (isClientOwner(clientId)
              && resource.data.status == 'unpaid'
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'cancelledAt']));
        allow delete: if isAdmin();
      }

      // Everything the client legitimately owns, at any depth.
      match /assessment/{d=**}     { allow read, write: if canAccess(clientId); }
      match /profile/{d=**}        { allow read, write: if canAccess(clientId); }
      match /checkpoints/{d=**}    { allow read, write: if canAccess(clientId); }
      match /measurements/{d=**}   { allow read, write: if canAccess(clientId); }
      match /workoutHistory/{d=**} { allow read, write: if canAccess(clientId); }
      match /sessionLoads/{d=**}   { allow read, write: if canAccess(clientId); }
      match /videos/{d=**}         { allow read, write: if canAccess(clientId); }
      match /progressPhotos/{d=**} { allow read, write: if canAccess(clientId); }
      match /nutrition/{d=**}      { allow read, write: if canAccess(clientId); }
      match /youthTests/{d=**}     { allow read, write: if canAccess(clientId); }
      // Dữ liệu hồi phục kéo từ Polar AccessLink (ngủ, HRV, nhịp tim nghỉ).
      // Phải liệt kê tường minh như mọi subcollection khác — không có wildcard
      // bao trùm, nên thiếu dòng này là client đọc ra permission-denied.
      match /recovery/{d=**}       { allow read, write: if canAccess(clientId); }
      // Bước chân, calo ngày và buổi tập kéo từ Polar. Tách khỏi recovery vì
      // đây là dữ liệu hoạt động ban ngày, không phải hồi phục ban đêm.
      match /activity/{d=**}       { allow read, write: if canAccess(clientId); }
    }
  }
}
