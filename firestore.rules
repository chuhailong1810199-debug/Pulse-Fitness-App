rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: là coach nếu email khớp HOẶC role == 'coach' trong Firestore
    function isCoach() {
      return request.auth != null && (
        request.auth.token.email == 'chuhailong1810199@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach')
      );
    }

    // ── Helper: user hiện tại là chủ của clientId (email khớp)
    // LƯU Ý: rule này chỉ an toàn khi mỗi email chỉ thuộc về DUY NHẤT một client.
    // Tính duy nhất được cưỡng chế bởi collection /clientEmails bên dưới —
    // không được bỏ nó đi, nếu không hai client trùng email sẽ đọc/ghi được data của nhau.
    function isClientOwner(clientId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/clients/$(clientId)) &&
        get(/databases/$(database)/documents/clients/$(clientId)).data.email == request.auth.token.email;
    }

    // ── CLIENT EMAIL INDEX — cưỡng chế 1 email = 1 client ─
    // Doc id chính là email (viết thường). Firestore phân biệt create với update:
    // doc chưa tồn tại -> 'create', doc đã tồn tại -> 'update'.
    // Cho phép create, chặn update => không thể chiếm email đã có người dùng.
    // Muốn đổi email cho client thì phải delete doc cũ rồi create doc mới.
    match /clientEmails/{emailKey} {
      allow read: if request.auth != null;

      // Coach đăng ký email cho bất kỳ client nào;
      // user tự đăng ký thì CHỈ được đăng ký chính email của mình.
      allow create: if request.auth != null
                    && request.resource.data.clientId is string
                    && request.resource.data.clientId.size() > 0
                    && (isCoach() || emailKey == request.auth.token.email.lower());

      allow update: if false;   // KHÔNG BAO GIỜ ghi đè — đây là chốt chặn duy nhất
      allow delete: if isCoach();
    }

    // ── LEADS collection ─────────────────────────────────
    // Public: ai cũng có thể tạo lead (contact form từ landing page)
    // Coach only: đọc, update, xóa
    match /leads/{leadId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'goal', 'frequency',
          'service', 'note', 'createdAt', 'source', 'status'
        ]);

      allow read, update, delete: if isCoach();
    }

    // ── USERS collection ─────────────────────────────────
    // Coach: toàn quyền (cần để dọn tài khoản mồ côi, gán lại clientId)
    // User thường: đọc profile của mình; tạo lần đầu khi đăng nhập;
    //   được sửa name/email của mình nhưng KHÔNG được tự đổi role hay clientId
    //   (nếu cho phép thì client có thể tự trỏ sang client khác).
    match /users/{uid} {
      allow read, write: if isCoach();

      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('role', 'client') != 'coach';
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('role', '')     == resource.data.get('role', '')
                    && request.resource.data.get('clientId', '') == resource.data.get('clientId', '');
      allow delete: if false;   // chỉ coach mới được xoá
    }

    // ── EXERCISES collection (thư viện bài tập) ──────────
    // Tất cả user đã login đều được đọc
    // Chỉ coach mới được thêm/sửa/xóa
    match /exercises/{docId} {
      allow read: if request.auth != null;
      allow write: if isCoach();
    }

    // ── BOOKINGS collection (coach schedule only) ─────────
    // Chi tiết tài khoản nhận tiền của coach. Khách PHẢI đọc được để chuyển
    // khoản — số tài khoản sinh ra để chia sẻ — nhưng chỉ coach được sửa.
    match /settings/{docId} {
      allow read:  if request.auth != null;
      allow write: if isCoach();
    }

    match /bookings/{bookingId} {
      allow read, write: if isCoach();
    }

    // ── CLIENTS collection ────────────────────────────────
    // Coach: full access tất cả clients
    // Client: chỉ đọc/ghi data của chính mình (khớp email)
    match /clients/{clientId} {
      allow read: if isCoach() || isClientOwner(clientId);
      allow create, delete: if isCoach();

      // A client may edit their own name and their own program, and the app
      // writes their storage figure as files land. `access` is money — it is
      // what says the subscription is paid until — so only the coach sets it.
      // Hiding the buttons is not a control; this is.
      allow update: if isCoach()
        || (isClientOwner(clientId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['access']));

      // Invoices are readable by the client so they can pay, and writable only
      // by the coach. This must NOT be covered by a broader wildcard below:
      // allow rules are OR-ed, so one permissive match would undo this one.
      // A client may raise their own invoice — that is a request to pay, not a
      // grant of access. Two things keep it honest: it must be created unpaid,
      // and the amount must equal the published price for the plan it names,
      // so a client cannot invoice themselves 1.000 d for the top tier.
      // Only the coach may ever mark one paid; that is what extends access.
      match /invoices/{invoiceId} {
        allow read:   if isCoach() || isClientOwner(clientId);
        allow create: if isCoach()
          || (isClientOwner(clientId)
              && request.resource.data.status == 'unpaid'
              && request.resource.data.paidAt == null
              && request.resource.data.kind == 'access'
              && request.resource.data.amount ==
                 get(/databases/$(database)/documents/settings/plans).data[request.resource.data.planId].price
              && request.resource.data.months ==
                 get(/databases/$(database)/documents/settings/plans).data[request.resource.data.planId].months);
        allow update, delete: if isCoach();
      }

      // Everything the client legitimately owns, at any depth.
      match /assessment/{d=**}     { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /profile/{d=**}        { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /checkpoints/{d=**}    { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /measurements/{d=**}   { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /workoutHistory/{d=**} { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /sessionLoads/{d=**}   { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /videos/{d=**}         { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /progressPhotos/{d=**} { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /nutrition/{d=**}      { allow read, write: if isCoach() || isClientOwner(clientId); }
      match /youthTests/{d=**}     { allow read, write: if isCoach() || isClientOwner(clientId); }
    }
  }
}
